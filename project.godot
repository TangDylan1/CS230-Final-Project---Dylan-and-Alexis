; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spiritbreakers"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/autoloads/settings_manager.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=480
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/themes/bold_pixels_theme.tres"

